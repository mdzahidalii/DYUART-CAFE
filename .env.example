# ==============================================================================
# DYU Art Cafe — Production & Development Environment Variables Template
# ==============================================================================
# Instructions:
# 1. LOCAL DEVELOPMENT:
#    Copy this file to `.env`:
#      copy .env.example .env
#    Provide your MongoDB Atlas URI and Razorpay Test credentials.
#
# 2. PRODUCTION DEPLOYMENT:
#    Do NOT upload or commit `.env` to Git repository.
#    Instead, set these environment variables in your cloud hosting dashboard:
#    - SECTION A: Configure in your Backend host (e.g., Render / Railway / Fly.io)
#    - SECTION B: Configure in your Frontend host (e.g., Vercel / Netlify)
# ==============================================================================

# ==============================================================================
# SECTION A: BACKEND HOST ENVIRONMENT VARIABLES
# Set these in your Node.js hosting platform (Render / Railway / Heroku / Fly.io)
# ==============================================================================

# Node Environment ('production' enables production security and caching)
NODE_ENV=production

# Server Port (PaaS hosts like Render/Railway automatically assign PORT dynamically)
PORT=5000

# Allowed Frontend Origins for Cross-Origin Resource Sharing (CORS)
# Multiple origins can be comma-separated. Include your live Vercel domain and localhost for dev:
FRONTEND_URL=https://your-cafe-frontend.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-cafe-frontend.vercel.app,http://localhost:5173

# Database Name & MongoDB Atlas Connection String
# 1. In MongoDB Atlas, go to Network Access -> Add IP Address: 0.0.0.0/0 (allow cloud host dynamic IPs).
# 2. Go to Database Access -> Create database user with readWrite permission.
# 3. Paste the connection string with your username and password below:
DB_NAME=dyu_art_cafe
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dyu_art_cafe?retryWrites=true&w=majority

# Razorpay Test Mode Credentials (Backend only — NEVER expose SECRET to frontend)
# Obtain these from: Razorpay Dashboard > Settings > API Keys (Ensure "Test Mode" is active)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere_FromDashboard

# Staff / Admin Authentication & Initial Account Bootstrap (Backend only)
# Used on initial server boot to seed the primary admin account if none exists.
ADMIN_EMAIL=admin@dyuartcafe.com
ADMIN_INITIAL_PASSWORD=YourSecureAdminPasswordHere
ADMIN_JWT_SECRET=YourAdminJwtSecretKeyHere_ChangeInProduction

# Customer Authentication JWT Secret (Optional override, defaults to secure random or ADMIN_JWT_SECRET)
# CUSTOMER_JWT_SECRET=YourCustomerJwtSecretKeyHere_ChangeInProduction


# ==============================================================================
# SECTION B: FRONTEND HOST ENVIRONMENT VARIABLES
# Set these in your Static / SPA hosting platform (Vercel Project Settings > Environment Variables)
# Note: Only variables prefixed with VITE_ are embedded into the client bundle at build time.
# NEVER put secrets (such as Razorpay Secret or DB password) here!
# ==============================================================================

# Production API Base URL pointing to your deployed backend
# Example: https://dyu-art-backend.onrender.com/api
# Leave empty or set to /api if hosting behind a unified domain reverse-proxy or during local development
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

# Google Maps JavaScript API Key
# Generated in Google Cloud Console > APIs & Services > Credentials
# Restrict this key under Application Restrictions to HTTP referrers:
# e.g., https://your-cafe-frontend.vercel.app/* and http://localhost:5173/*
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Google OAuth 2.0 Client ID for Customer Google Sign-In (Optional)
# Generated in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript Origins: https://your-cafe-frontend.vercel.app and http://localhost:5173
# Authorized redirect URIs: https://your-cafe-frontend.vercel.app
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Optional Geographic Coordinates & Zoom Override (Defaults to Koramangala, Bengaluru)
# VITE_CAFE_LAT=12.9352
# VITE_CAFE_LNG=77.6195
# VITE_MAP_ZOOM=16
